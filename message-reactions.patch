diff --git a/test/message_reactions_test.dart b/test/message_reactions_test.dart
new file mode 100644
index 0000000..a25aa6e
--- /dev/null
+++ b/test/message_reactions_test.dart
@@ -0,0 +1,76 @@
+import 'package:chatme/models/chat_message.dart';
+import 'package:chatme/widgets/message_bubble.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  const thumbsUp = '\u{1F44D}';
+  const smile = '\u{1F600}';
+
+  Widget bubble(String text, {required bool isMe}) {
+    return MessageBubble(
+      message: ChatMessage(
+        id: 'message-1',
+        senderPubkey: isMe ? 'me' : 'you',
+        receiverPubkey: isMe ? 'you' : 'me',
+        content: '',
+        plaintext: text,
+        timestamp: DateTime(2026, 1, 2, 15, 4).millisecondsSinceEpoch,
+        status: 'sent',
+        chatKey: 'chat',
+        reactions: const {'you': thumbsUp},
+      ),
+      isMe: isMe,
+      isDark: false,
+      isNostrCyber: false,
+      bubbleColor: const Color(0xFFE3F2FD),
+      textColor: Colors.black,
+      footer: const Text('15:04', style: TextStyle(fontSize: 11)),
+      imageFooter: const Text('15:04'),
+    );
+  }
+
+  Widget app(Widget child) {
+    return MaterialApp(
+      home: Scaffold(
+        body: Align(
+          alignment: Alignment.topLeft,
+          child: SizedBox(width: 360, child: SingleChildScrollView(child: child)),
+        ),
+      ),
+    );
+  }
+
+  // The visible bubble ends 12 px (sent) or 50 px (received) before the
+  // surface rect, because that is the outer margin on each side.
+  for (final isMe in [true, false]) {
+    final who = isMe ? 'sent' : 'received';
+    final margin = isMe ? 12.0 : 50.0;
+
+    testWidgets('a reaction on a $who text message sits at the bottom right',
+        (tester) async {
+      await tester.pumpWidget(app(bubble('Hello captain', isMe: isMe)));
+
+      final surface = tester.getRect(find.byKey(const Key('message_bubble_surface')));
+      final reaction = tester.getRect(find.byKey(const Key('message_reactions')));
+
+      expect(reaction.right, moreOrLessEquals(surface.right - margin - 8, epsilon: 0.5));
+      expect(reaction.bottom, greaterThan(surface.bottom));
+    });
+
+    testWidgets('a reaction on a $who emoji message sits under the right side of the message',
+        (tester) async {
+      await tester.pumpWidget(app(bubble(smile, isMe: isMe)));
+
+      final pill = tester.getRect(find.byKey(const Key('emoji_footer')));
+      final emoji = tester.getRect(find.byKey(const Key('emoji_message')));
+      final reaction = tester.getRect(find.byKey(const Key('message_reactions')));
+
+      // The content is as wide as the wider of the emoji and the pill.
+      final contentRight = emoji.right > pill.right ? emoji.right : pill.right;
+      expect(reaction.right, moreOrLessEquals(contentRight - 8, epsilon: 0.5));
+      expect(reaction.top, greaterThan(pill.top));
+      expect(reaction.bottom, greaterThan(pill.bottom));
+    });
+  }
+}
